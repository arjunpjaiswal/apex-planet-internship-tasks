{
  "name": "apexplanet-internship-tasks",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ApexPlanet Frontend Internship portfolio showcasing 5 production-grade tasks",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint src/ tests/ --ext .js",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic --exit-zero-on-changes",
    "deploy": "netlify deploy --prod --dir=dist"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@sentry/browser": "^8.38.0",
    "web-vitals": "^4.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.49.0",
    "@storybook/addon-a11y": "^8.4.5",
    "@storybook/addon-essentials": "^8.4.5",
    "@storybook/addon-interactions": "^8.4.5",
    "@storybook/addon-links": "^8.4.5",
    "@storybook/addon-themes": "^8.4.5",
    "@storybook/blocks": "^8.4.5",
    "@storybook/html": "^8.4.5",
    "@storybook/html-vite": "^8.4.5",
    "@storybook/test": "^8.4.5",
    "@vitest/coverage-v8": "^2.1.5",
    "chromatic": "^11.18.1",
    "eslint": "^8.57.1",
    "jsdom": "^25.0.1",
    "storybook": "^8.4.5",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
